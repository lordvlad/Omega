{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 110,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "insertFinalNewline": true,
  "sortImports": true,
  "ignorePatterns": ["openapi.json", "src/client/api/**"]
}
