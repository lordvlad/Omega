{
  "name": "omega",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "schema": "bun run src/shared/schema.ts > openapi.json",
    "gen:api": "bun run schema && bun node_modules/wiz/src/cli.ts generate -g reactQuery openapi.json --outdir src/client/api",
    "lint": "oxlint --config oxlint.config.ts src/",
    "lint:fix": "oxlint --config oxlint.config.ts --fix src/",
    "format": "oxfmt --config oxfmt.config.ts --write src/",
    "format:check": "oxfmt --config oxfmt.config.ts --check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/charts": "^9.6.1",
    "@mantine/code-highlight": "^9.6.1",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@mantine/spotlight": "9.6.1",
    "@oh-my-pi/pi-coding-agent": "18.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/ai": "^0.53.0",
    "@tanstack/query-sync-storage-persister": "^5.103.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.103.0",
    "@tanstack/react-router": "1.160.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxc-config-mantine": "^1.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.7.3",
    "wiz": "github:lordvlad/Wiz#main"
  }
}
